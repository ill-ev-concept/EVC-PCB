	(text "Wiper\n"
		(exclude_from_sim no)
		(at 89.408 24.384 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "31f3688c-5bc4-4437-a08c-e89f3565138a")
	)
	(text "The wiper and its respective indicator LEDs\nare controlled by the same 2-pole 6-position\nrotary switch. WIPER_OFF, _LOW, _MID, and _HIGH\nneed to be connected to active-low GPIO pins.\n\nThe switch will be limited to 4 positions using\nthe built-in stop ring."
		(exclude_from_sim no)
		(at 105.156 37.592 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "3c6bad75-1fb8-4dc2-a5be-f2cb2d86f1f4")
	)
	(text "All INDIC_ labels should be connected to active-low GPIOs.\nLED_LEFT and _RIGHT should be connected to output GPIOS\nthat are set LOW when active."
		(exclude_from_sim no)
		(at 105.41 165.354 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "8343a04f-048f-4be8-933d-1b0035983443")
	)
	(text "Indicators\n"
		(exclude_from_sim no)
		(at 91.186 149.606 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "88f86c5c-a0b5-451e-90ed-d6329b29fefb")
	)
	(text "HORN needs to be connected to an active-low GPIO.\nLED_HORN needs to be connected to a GPIO output pin\nthat is set LOW when active."
		(exclude_from_sim no)
		(at 105.664 102.362 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "9bd212ce-aada-47fa-be58-923d60f328e2")
	)
